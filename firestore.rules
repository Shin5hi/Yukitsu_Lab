rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidFolder(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.color is string && data.color.size() <= 20 &&
             data.icon is string && data.icon.size() <= 40 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 300)) &&
             data.itemCount is int && data.itemCount >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCreation(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 1000 &&
             (!('enhancedPrompt' in data) || (data.enhancedPrompt is string && data.enhancedPrompt.size() <= 2000)) &&
             data.genre in ['shonen', 'seinen', 'kodomo', 'shojo', 'josei', 'mecha', 'all'] &&
             data.style in ['retro_90s', 'modern_digital', 'manga_ink', 'ghibli', 'cyberpunk', 'chibi', 'watercolor'] &&
             data.mediaType in ['image', 'video', 'gif'] &&
             (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 200000)) &&
             data.aspectRatio in ['1:1', '16:9', '9:16', '4:3', '3:4', '2:3', '3:2', '21:9'] &&
             (!('folderId' in data) || (data.folderId is string && data.folderId.size() <= 128)) &&
             data.tags is list && data.tags.size() <= 15 && (data.tags.size() == 0 || data.tags[0] is string) &&
             (!('customCss' in data) || (data.customCss is string && data.customCss.size() <= 4000)) &&
             data.isFavorite is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCommunityCreation(data) {
      return data.userId is string &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 1000 &&
             (!('enhancedPrompt' in data) || (data.enhancedPrompt is string && data.enhancedPrompt.size() <= 2000)) &&
             data.genre in ['shonen', 'seinen', 'kodomo', 'shojo', 'josei', 'mecha', 'all'] &&
             data.style in ['retro_90s', 'modern_digital', 'manga_ink', 'ghibli', 'cyberpunk', 'chibi', 'watercolor'] &&
             data.mediaType in ['image', 'video', 'gif'] &&
             (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 200000)) &&
             data.aspectRatio in ['1:1', '16:9', '9:16', '4:3', '3:4', '2:3', '3:2', '21:9'] &&
             data.tags is list && data.tags.size() <= 15 && (data.tags.size() == 0 || data.tags[0] is string) &&
             (!('customCss' in data) || (data.customCss is string && data.customCss.size() <= 4000)) &&
             data.likesCount is int && data.likesCount >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTheme(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 50 &&
             data.cssCode is string && data.cssCode.size() >= 1 && data.cssCode.size() <= 4000 &&
             data.isCurrentActive is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get, write: if isOwner(userId);

      match /folders/{folderId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(folderId) &&
                         isValidFolder(request.resource.data) &&
                         request.resource.data.keys().hasAll(['userId', 'name', 'color', 'icon', 'itemCount', 'createdAt', 'updatedAt']) &&
                         request.resource.data.keys().hasOnly(['userId', 'name', 'color', 'icon', 'description', 'itemCount', 'createdAt', 'updatedAt']);
        allow update: if isOwner(userId) &&
                         isValidId(folderId) &&
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         isValidFolder(request.resource.data) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'color', 'icon', 'description', 'itemCount', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(folderId);
      }

      match /creations/{creationId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(creationId) &&
                         isValidCreation(request.resource.data) &&
                         request.resource.data.keys().hasAll(['userId', 'title', 'prompt', 'genre', 'style', 'mediaType', 'aspectRatio', 'tags', 'isFavorite', 'createdAt', 'updatedAt']) &&
                         request.resource.data.keys().hasOnly(['userId', 'title', 'prompt', 'enhancedPrompt', 'genre', 'style', 'mediaType', 'mediaUrl', 'aspectRatio', 'folderId', 'tags', 'customCss', 'isFavorite', 'createdAt', 'updatedAt']);
        allow update: if isOwner(userId) &&
                         isValidId(creationId) &&
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         isValidCreation(request.resource.data) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'prompt', 'enhancedPrompt', 'genre', 'style', 'mediaType', 'mediaUrl', 'aspectRatio', 'folderId', 'tags', 'customCss', 'isFavorite', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(creationId);
      }

      match /themes/{themeId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(themeId) &&
                         isValidTheme(request.resource.data) &&
                         request.resource.data.keys().hasAll(['userId', 'name', 'cssCode', 'isCurrentActive', 'createdAt', 'updatedAt']) &&
                         request.resource.data.keys().hasOnly(['userId', 'name', 'cssCode', 'isCurrentActive', 'createdAt', 'updatedAt']);
        allow update: if isOwner(userId) &&
                         isValidId(themeId) &&
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         isValidTheme(request.resource.data) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'cssCode', 'isCurrentActive', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(themeId);
      }
    }

    match /community_creations/{creationId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() &&
                       isValidId(creationId) &&
                       request.resource.data.userId == request.auth.uid &&
                       isValidCommunityCreation(request.resource.data) &&
                       request.resource.data.keys().hasAll(['userId', 'authorName', 'title', 'prompt', 'genre', 'style', 'mediaType', 'aspectRatio', 'tags', 'likesCount', 'createdAt', 'updatedAt']) &&
                       request.resource.data.keys().hasOnly(['userId', 'authorName', 'title', 'prompt', 'enhancedPrompt', 'genre', 'style', 'mediaType', 'mediaUrl', 'aspectRatio', 'tags', 'customCss', 'likesCount', 'createdAt', 'updatedAt']);
      allow update: if isSignedIn() &&
                       isValidId(creationId) &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       isValidCommunityCreation(request.resource.data) &&
                       (request.auth.uid == resource.data.userId || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'updatedAt']));
      allow delete: if isSignedIn() && isValidId(creationId) && resource.data.userId == request.auth.uid;

      match /likes/{likeUserId} {
        allow get, list: if isSignedIn();
        allow create, delete: if isSignedIn() && request.auth.uid == likeUserId;
      }
    }
  }
}
